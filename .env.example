# ============================================================
# Outline – Umgebungsvariablen
# Kopiere als .env und fülle alle Werte aus.
# SECRET_KEY und UTILS_SECRET: openssl rand -hex 32
# ============================================================

# App
SECRET_KEY=generiere_mit_openssl_rand_hex_32
UTILS_SECRET=generiere_mit_openssl_rand_hex_32
URL=https://members.obscura-collective.de
PORT=3000
NODE_ENV=production

# Datenbank
DATABASE_URL=postgres://outline:POSTGRES_PASSWORD@outline-postgres:5432/outline
POSTGRES_PASSWORD=sicheres_passwort_hier
PGSSLMODE=disable

# Redis
REDIS_URL=redis://outline-redis:6379

# E-Mail (Magic Link via Resend SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_DEIN_RESEND_API_KEY
SMTP_FROM_EMAIL=noreply@obscura-collective.de
SMTP_SECURE=true

# Datei-Uploads (lokal)
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=26214400

# Sprache
DEFAULT_LANGUAGE=de_DE
